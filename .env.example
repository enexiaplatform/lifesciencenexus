# Life Science Nexus environment configuration.
# Copy to .env.local and fill in. With no Supabase vars set, the app runs in
# demo mode with synthetic data labeled "Demo".

# --- Site ---
# Canonical origin of the deployment. Used for metadata and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (leave empty for demo mode) ---
# Setting NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_ANON_KEY enables
# Supabase Auth and gates all workspace routes behind login (public routes:
# /, /pricing, /contact, /legal/*, the auth pages, and /api/*). Leave both
# unset to run the open public demo (demo mode).
# Project URL, e.g. https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable anon key (safe for the browser; access is enforced by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key. SERVER ONLY — never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# --- Data backend ---
# "supabase" or "demo". Default: auto — "supabase" when URL + anon key are
# set, otherwise "demo".
NEXUS_DATA_BACKEND=
# Tenant id used for the synthetic demo dataset.
NEXUS_DEMO_TENANT_ID=demo-tenant

# --- Feature flags ---
# Enable AI-assisted evidence extraction pipeline ("true"/"false").
NEXUS_ENABLE_AI_EXTRACTION=false

# --- External integrations (optional) ---
# MEMOIRE_INTEGRATION_URL=https://memoire.example.com
# ATLAS_INTEGRATION_URL=https://atlas.example.com
