{
  "name": "life-science-nexus",
  "version": "0.1.0",
  "private": true,
  "description": "Industry and Product Intelligence Graph for life science markets. Initial wedge: industrial microbiology in Vietnam.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "db:migrate": "supabase db push",
    "verify:rls": "psql \"$DATABASE_URL\" -f scripts/verify-rls.sql",
    "verify:data-isolation": "psql \"$DATABASE_URL\" -f scripts/verify-data-isolation.sql",
    "verify:evidence": "node scripts/verify-migrations.mjs",
    "verify:demo-separation": "node scripts/verify-migrations.mjs --demo-checks",
    "verify:integrations": "vitest run src/lib/integrations",
    "verify:production-readiness": "npm run check && node scripts/verify-migrations.mjs && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.27.0",
    "next": "15.5.22",
    "papaparse": "5.5.4",
    "react": "19.0.8",
    "react-dom": "19.0.8",
    "recharts": "3.10.1",
    "tailwind-merge": "3.6.0",
    "xlsx": "0.18.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.22",
    "jsdom": "^26.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
